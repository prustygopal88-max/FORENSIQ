# Application Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Unified Forensic Database Path
DATABASE_PATH=backend/forensiq.db

# Machine Identifier for live forensics
DEFAULT_MACHINE=FORENSIQ-PC

# Default Investigator Persona
DEFAULT_INVESTIGATOR=Gopal

# Environment Mode (development / production)
ENVIRONMENT=development
